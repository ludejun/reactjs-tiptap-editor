# The simplest setup: one URL on your backend that answers { text } or an SSE
# stream of { text } deltas (see docs → AI → Your endpoint). No key in the browser.
VITE_AI_ENDPOINT=/api/ai

# Or call a provider directly. VITE_ values are visible in the browser bundle,
# so use this for local testing only.
VITE_AI_PROTOCOL=openai
VITE_AI_MODEL=
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
